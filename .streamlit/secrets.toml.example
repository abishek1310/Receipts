# Streamlit Community Cloud secrets (CLAUDE.md §10: "Keep secrets in st.secrets").
#
# Do NOT commit the real file. `.streamlit/secrets.toml` is gitignored.
#
# Locally you do not need this at all — use .env instead. This exists for the
# deployed app, where there is no .env: paste the contents below into
#   Streamlit Cloud -> your app -> Settings -> Secrets
#
# src/config.load_streamlit_secrets() copies these into the environment before
# Settings is read, so the same code path serves local and deployed runs.

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "your-key-here"
GEMINI_MODEL = "gemini-3.5-flash"
GEMINI_THINKING_BUDGET = "0"

TEMPERATURE = "0.7"
MAX_TOKENS = "4000"
RETRIEVAL_K = "40"
MAX_RETRIES = "2"
