# Copy to .env and fill in. .env is gitignored and must stay that way (§14).

# --- provider ---------------------------------------------------------------
# gemini | anthropic | openai — all three are implemented in src/llm.py.
LLM_PROVIDER=gemini

# Gemini: free tier, and it deploys (Streamlit Community Cloud cannot reach a
# local model, so a hosted API is required for §3's live URL).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest is frequently 503 on the free tier; 3.5-flash is
# steadier. Alternatives if it saturates: gemini-3.6-flash, gemini-3.7-flash.
GEMINI_MODEL=gemini-3.6-flash

# Failover chain, tried in order when a model is overloaded (503) or its daily
# quota is spent (429). Each model has its own 20-requests-per-day bucket.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview

# Gemini 2.5+ thinks by default and thinking tokens come out of MAX_TOKENS, which
# can return an empty body. 0 disables it. Raise it if attribution slips.
# Ignored for Gemma, which rejects the parameter outright (see src/llm.py).
GEMINI_THINKING_BUDGET=2048

# Gemma also works here — same endpoint, same key, a separate quota bucket, and
# it writes punchier hooks. Note it is a weaker model, so expect more citation
# rejections; that is useful for §11's natural-failure hunt and a liability on
# stage. Gemma 3 is retired from the API; the current names are:
#   gemma-4-26b-a4b-it, gemma-4-31b-it

# The providers §3 names. Uncomment the matching dependency in requirements.txt.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- generation -------------------------------------------------------------
# §7 asks for ~0.7. Current Claude models removed sampling parameters and reject
# it with a 400, so src/llm.py only forwards this to models that accept it
# (Gemini, OpenAI, Haiku 4.5). Safety comes from the validator, not this number.
TEMPERATURE=0.7
MAX_TOKENS=8000

# Anthropic-only depth knob: low | medium | high | xhigh | max.
EFFORT=medium

# --- retrieval and retries --------------------------------------------------
RETRIEVAL_K=40
MAX_RETRIES=2
