# Copy to .env and fill in. .env is gitignored and must stay that way (§14).

# --- provider ---------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# The swappable alternative (§3). Set LLM_PROVIDER=openai to use it.
# OPENAI_API_KEY=sk-...

# --- model ------------------------------------------------------------------
ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o

# Depth/cost knob on current Claude models: low | medium | high | xhigh | max.
# "medium" keeps the demo responsive; raise it if attribution quality slips.
EFFORT=medium

# §7 asks for ~0.7. Current Claude models removed sampling parameters and reject
# it with a 400, so src/llm.py only forwards this to models that accept it
# (Haiku 4.5, OpenAI). Safety comes from the validator, not from this number.
TEMPERATURE=0.7
MAX_TOKENS=4000

# --- retrieval and retries --------------------------------------------------
RETRIEVAL_K=40
MAX_RETRIES=2
